<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Security Groups -->
        <record id="group_hr_pro_user" model="res.groups">
            <field name="name">HR Pro User</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Basic access: can create and view own internal requests.</field>
        </record>

        <record id="group_hr_pro_manager" model="res.groups">
            <field name="name">HR Pro Manager</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('hr_management_pro.group_hr_pro_user'))]"/>
            <field name="comment">Manager access: can approve/reject requests and view all requests.</field>
        </record>

        <record id="group_hr_pro_admin" model="res.groups">
            <field name="name">HR Pro Admin</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('hr_management_pro.group_hr_pro_manager'))]"/>
            <field name="comment">Full access: HR approval, delete, and full administration.</field>
        </record>

        <!-- Record Rules -->

        <!-- Users: can only see their own requests -->
        <record id="rule_hr_internal_request_user" model="ir.rule">
            <field name="name">HR Internal Request: User sees own</field>
            <field name="model_id" ref="model_hr_internal_request"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('hr_management_pro.group_hr_pro_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Managers: can see requests from their department -->
        <record id="rule_hr_internal_request_manager" model="ir.rule">
            <field name="name">HR Internal Request: Manager sees all</field>
            <field name="model_id" ref="model_hr_internal_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr_management_pro.group_hr_pro_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Admins: full access -->
        <record id="rule_hr_internal_request_admin" model="ir.rule">
            <field name="name">HR Internal Request: Admin full access</field>
            <field name="model_id" ref="model_hr_internal_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr_management_pro.group_hr_pro_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
