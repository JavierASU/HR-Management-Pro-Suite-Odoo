<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_hr_internal_request_mass_approve_wizard_form" model="ir.ui.view">
            <field name="name">hr.internal.request.mass.approve.wizard.form</field>
            <field name="model">hr.internal.request.mass.approve.wizard</field>
            <field name="arch" type="xml">
                <form string="Mass Approve Requests">
                    <div class="alert alert-info" role="alert">
                        <i class="fa fa-info-circle"/>
                        Select the approval level and confirm to approve all listed requests at once.
                    </div>
                    <group>
                        <field name="approve_as" widget="radio"
                               options="{'horizontal': true}"/>
                    </group>
                    <separator string="Selected Requests"/>
                    <field name="request_ids" nolabel="1">
                        <tree editable="bottom" create="0" delete="0">
                            <field name="name" decoration-bf="1"/>
                            <field name="employee_id" widget="many2one_avatar_employee"/>
                            <field name="request_type" widget="badge"
                                   decoration-info="request_type == 'leave'"
                                   decoration-success="request_type == 'remote_work'"
                                   decoration-warning="request_type == 'equipment'"
                                   decoration-muted="request_type == 'permission'"/>
                            <field name="date_from" widget="date"/>
                            <field name="date_to" widget="date"/>
                            <field name="state" widget="badge"
                                   decoration-info="state == 'submitted'"
                                   decoration-warning="state == 'manager_approved'"/>
                        </tree>
                    </field>
                    <footer>
                        <button name="action_mass_approve" type="object"
                                string="Approve Selected"
                                class="btn-primary"
                                icon="fa-check-circle"
                                confirm="Are you sure you want to approve all selected requests?"/>
                        <button name="action_mass_reject" type="object"
                                string="Reject Selected"
                                class="btn-danger"
                                icon="fa-times-circle"
                                confirm="Are you sure you want to reject all selected requests?"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_hr_internal_request_mass_approve_wizard" model="ir.actions.act_window">
            <field name="name">Mass Approve Requests</field>
            <field name="res_model">hr.internal.request.mass.approve.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="hr_management_pro.model_hr_internal_request"/>
            <field name="binding_view_types">list</field>
        </record>

    </data>
</odoo>
