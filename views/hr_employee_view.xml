<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Employee Form Extension -->
        <record id="view_employee_form_hr_pro" model="ir.ui.view">
            <field name="name">hr.employee.form.hr.pro</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_internal_requests"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                            invisible="internal_request_count == 0">
                        <field name="internal_request_count"
                               widget="statinfo"
                               string="Requests"/>
                    </button>
                </xpath>
                <notebook position="inside">
                    <page string="HR Pro" name="hr_pro">
                        <group>
                            <group string="Professional Profile">
                                <field name="seniority_level" widget="radio"
                                       options="{'horizontal': true}"/>
                                <field name="contract_type"/>
                                <field name="work_modality" widget="radio"
                                       options="{'horizontal': true}"/>
                            </group>
                            <group string="Performance">
                                <field name="performance_score"
                                       widget="progressbar"
                                       options="{'max_value': 10.0, 'editable': true}"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </field>
        </record>

        <!-- Employee Tree Extension - add request count -->
        <record id="view_employee_tree_hr_pro" model="ir.ui.view">
            <field name="name">hr.employee.tree.hr.pro</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='department_id']" position="after">
                    <field name="seniority_level" optional="hide"/>
                    <field name="work_modality" optional="hide"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
