<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- ============================================================ -->
        <!--                        TREE VIEW                             -->
        <!-- ============================================================ -->
        <record id="view_hr_internal_request_tree" model="ir.ui.view">
            <field name="name">hr.internal.request.tree</field>
            <field name="model">hr.internal.request</field>
            <field name="arch" type="xml">
                <tree string="Internal Requests"
                      decoration-muted="state == 'draft'"
                      decoration-info="state == 'submitted'"
                      decoration-warning="state == 'manager_approved'"
                      decoration-success="state == 'hr_approved'"
                      decoration-danger="state == 'rejected'"
                      multi_edit="1"
                      sample="1">
                    <field name="name" decoration-bf="1"/>
                    <field name="employee_id" widget="many2one_avatar_employee"/>
                    <field name="department_id" optional="show"/>
                    <field name="request_type" widget="badge"
                           decoration-info="request_type == 'leave'"
                           decoration-success="request_type == 'remote_work'"
                           decoration-warning="request_type == 'equipment'"
                           decoration-muted="request_type == 'permission'"/>
                    <field name="date_from" widget="date"/>
                    <field name="date_to" widget="date"/>
                    <field name="duration_days" optional="show" string="Days"
                           widget="float" digits="[5,1]"/>
                    <field name="manager_id" widget="many2one_avatar_employee" optional="hide"/>
                    <field name="hr_responsible_id" widget="many2one_avatar_employee" optional="hide"/>
                    <field name="priority" widget="priority" optional="show"/>
                    <field name="state" widget="badge"
                           decoration-muted="state == 'draft'"
                           decoration-info="state == 'submitted'"
                           decoration-warning="state == 'manager_approved'"
                           decoration-success="state == 'hr_approved'"
                           decoration-danger="state == 'rejected'"/>
                </tree>
            </field>
        </record>

        <!-- ============================================================ -->
        <!--                       KANBAN VIEW                            -->
        <!-- ============================================================ -->
        <record id="view_hr_internal_request_kanban" model="ir.ui.view">
            <field name="name">hr.internal.request.kanban</field>
            <field name="model">hr.internal.request</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state"
                        class="o_kanban_hr_internal_request"
                        sample="1"
                        quick_create="false">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="request_type"/>
                    <field name="state"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="duration_days"/>
                    <field name="color"/>
                    <field name="manager_id"/>
                    <field name="priority"/>
                    <field name="activity_state"/>
                    <progressbar field="state"
                                 colors='{"draft": "muted", "submitted": "info", "manager_approved": "warning", "hr_approved": "success", "rejected": "danger"}'/>
                    <templates>
                        <t t-name="kanban-menu">
                            <a role="menuitem" type="edit" class="dropdown-item">Edit</a>
                            <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                            <div role="separator" class="dropdown-divider"/>
                            <div class="o_kanban_colorpicker" data-field="color"/>
                        </t>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)} oe_kanban_global_click oe_kanban_card o_kanban_hr_request_card">
                                <div class="oe_kanban_content">
                                    <!-- Header -->
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                        </div>
                                        <div>
                                            <field name="priority" widget="priority"/>
                                        </div>
                                    </div>

                                    <!-- Body -->
                                    <div class="o_kanban_record_body">
                                        <div class="d-flex align-items-center mb-1">
                                            <field name="employee_id" widget="many2one_avatar_employee"/>
                                        </div>
                                        <div class="mt-1">
                                            <field name="request_type" widget="badge"
                                                   decoration-info="request_type == 'leave'"
                                                   decoration-success="request_type == 'remote_work'"
                                                   decoration-warning="request_type == 'equipment'"
                                                   decoration-muted="request_type == 'permission'"/>
                                        </div>
                                        <div class="text-muted small mt-1">
                                            <i class="fa fa-calendar-o" title="Date range"/>
                                            <field name="date_from" widget="date"/>
                                            <i class="fa fa-long-arrow-right mx-1" title="to"/>
                                            <field name="date_to" widget="date"/>
                                        </div>
                                    </div>

                                    <!-- Footer -->
                                    <div class="o_kanban_record_bottom mt-2">
                                        <div class="oe_kanban_bottom_left">
                                            <field name="activity_ids" widget="kanban_activity"/>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <span class="text-muted small me-1">
                                                <field name="duration_days" widget="float" digits="[5,1]"/>d
                                            </span>
                                            <field name="manager_id" widget="many2one_avatar_employee"
                                                   t-if="record.manager_id.raw_value"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ============================================================ -->
        <!--                        FORM VIEW                             -->
        <!-- ============================================================ -->
        <record id="view_hr_internal_request_form" model="ir.ui.view">
            <field name="name">hr.internal.request.form</field>
            <field name="model">hr.internal.request</field>
            <field name="arch" type="xml">
                <form string="Internal Request">
                    <header>
                        <button name="action_submit" type="object" string="Submit"
                                class="btn-primary"
                                icon="fa-paper-plane"
                                invisible="state != 'draft'"
                                confirm="Are you sure you want to submit this request?"/>
                        <button name="action_manager_approve" type="object" string="Manager Approve"
                                class="btn-primary"
                                icon="fa-check"
                                invisible="state != 'submitted'"
                                groups="hr_management_pro.group_hr_pro_manager"
                                confirm="Approve this request as manager?"/>
                        <button name="action_hr_approve" type="object" string="HR Approve"
                                class="btn-success"
                                icon="fa-check-circle"
                                invisible="state != 'manager_approved'"
                                groups="hr_management_pro.group_hr_pro_admin"
                                confirm="Give final HR approval for this request?"/>
                        <button name="action_reject" type="object" string="Reject"
                                class="btn-danger"
                                icon="fa-times"
                                invisible="state not in ('submitted', 'manager_approved')"
                                groups="hr_management_pro.group_hr_pro_manager"
                                confirm="Are you sure you want to reject this request?"/>
                        <button name="action_reset_draft" type="object" string="Reset to Draft"
                                icon="fa-undo"
                                invisible="state != 'rejected'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,submitted,manager_approved,hr_approved"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                        </div>
                        <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger"
                                invisible="state != 'rejected'"/>
                        <widget name="web_ribbon" title="Approved" bg_color="text-bg-success"
                                invisible="state != 'hr_approved'"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1 class="d-flex align-items-center">
                                <field name="priority" widget="priority" class="me-3"/>
                                <field name="name" readonly="1" placeholder="New"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Request Details">
                                <field name="employee_id" widget="many2one_avatar_employee"
                                       readonly="state != 'draft'"/>
                                <field name="department_id"/>
                                <field name="request_type" widget="radio"
                                       readonly="state != 'draft'"/>
                            </group>
                            <group string="Schedule">
                                <field name="date_from" readonly="state != 'draft'"/>
                                <field name="date_to" readonly="state != 'draft'"/>
                                <field name="duration_days" widget="float" digits="[5,1]"/>
                            </group>
                        </group>
                        <group>
                            <group string="Approval Chain">
                                <field name="manager_id" widget="many2one_avatar_employee"/>
                                <field name="hr_responsible_id" widget="many2one_avatar_employee"/>
                            </group>
                            <group string="Additional Info">
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="create_date" string="Request Date" readonly="1"
                                       invisible="not id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Reason" name="reason" icon="fa-comment-o">
                                <field name="reason"
                                       placeholder="Describe the reason for this request..."
                                       readonly="state != 'draft'"/>
                            </page>
                            <page string="Rejection" name="rejection" icon="fa-ban"
                                  invisible="state != 'rejected' and not rejection_reason">
                                <group>
                                    <field name="rejection_reason" readonly="state != 'rejected'"
                                           nolabel="1"
                                           placeholder="Specify the reason for rejection..."/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- ============================================================ -->
        <!--                      CALENDAR VIEW                           -->
        <!-- ============================================================ -->
        <record id="view_hr_internal_request_calendar" model="ir.ui.view">
            <field name="name">hr.internal.request.calendar</field>
            <field name="model">hr.internal.request</field>
            <field name="arch" type="xml">
                <calendar string="Internal Requests"
                          date_start="date_from"
                          date_stop="date_to"
                          color="request_type"
                          mode="month"
                          event_limit="5"
                          quick_create="0">
                    <field name="employee_id" widget="many2one_avatar_employee"/>
                    <field name="request_type"/>
                    <field name="state"/>
                    <field name="duration_days"/>
                </calendar>
            </field>
        </record>

        <!-- ============================================================ -->
        <!--                      ACTIVITY VIEW                           -->
        <!-- ============================================================ -->
        <record id="view_hr_internal_request_activity" model="ir.ui.view">
            <field name="name">hr.internal.request.activity</field>
            <field name="model">hr.internal.request</field>
            <field name="arch" type="xml">
                <activity string="Internal Requests">
                    <templates>
                        <div t-name="activity-box">
                            <img t-att-src="activity_image('hr.employee', 'avatar_128', record.employee_id.raw_value)"
                                 t-att-title="record.employee_id.value"
                                 t-att-alt="record.employee_id.value"/>
                            <div>
                                <field name="name" display="full"/>
                                <field name="request_type" muted="1" display="full"/>
                            </div>
                        </div>
                    </templates>
                </activity>
            </field>
        </record>

        <!-- ============================================================ -->
        <!--                       SEARCH VIEW                            -->
        <!-- ============================================================ -->
        <record id="view_hr_internal_request_search" model="ir.ui.view">
            <field name="name">hr.internal.request.search</field>
            <field name="model">hr.internal.request</field>
            <field name="arch" type="xml">
                <search string="Internal Requests">
                    <field name="name" string="Reference"/>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="request_type"/>
                    <field name="manager_id" string="Manager"/>
                    <separator/>
                    <filter string="My Requests" name="my_requests"
                            domain="[('employee_id.user_id', '=', uid)]"
                            icon="fa-user"/>
                    <filter string="My Team" name="my_team"
                            domain="[('manager_id.user_id', '=', uid)]"
                            icon="fa-users"/>
                    <separator/>
                    <filter string="Draft" name="draft"
                            domain="[('state', '=', 'draft')]"/>
                    <filter string="Pending" name="pending"
                            domain="[('state', '=', 'submitted')]"/>
                    <filter string="Manager Approved" name="manager_approved"
                            domain="[('state', '=', 'manager_approved')]"/>
                    <filter string="HR Approved" name="hr_approved"
                            domain="[('state', '=', 'hr_approved')]"/>
                    <filter string="Rejected" name="rejected"
                            domain="[('state', '=', 'rejected')]"/>
                    <separator/>
                    <filter string="Leave" name="filter_leave"
                            domain="[('request_type', '=', 'leave')]"/>
                    <filter string="Permission" name="filter_permission"
                            domain="[('request_type', '=', 'permission')]"/>
                    <filter string="Equipment" name="filter_equipment"
                            domain="[('request_type', '=', 'equipment')]"/>
                    <filter string="Remote Work" name="filter_remote_work"
                            domain="[('request_type', '=', 'remote_work')]"/>
                    <separator/>
                    <filter string="This Month" name="this_month"
                            domain="[('create_date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%%Y-%%m-%%d'))]"/>
                    <filter string="Last 90 Days" name="last_90_days"
                            domain="[('create_date', '&gt;=', (context_today() - relativedelta(days=90)).strftime('%%Y-%%m-%%d'))]"/>
                    <filter string="High Priority" name="high_priority"
                            domain="[('priority', '=', '2')]"/>
                    <separator/>
                    <filter string="Late Activities" name="activities_overdue"
                            domain="[('my_activity_date_deadline', '&lt;', context_today().strftime('%%Y-%%m-%%d'))]"/>
                    <filter string="Today Activities" name="activities_today"
                            domain="[('my_activity_date_deadline', '=', context_today().strftime('%%Y-%%m-%%d'))]"/>
                    <filter string="Upcoming Activities" name="activities_upcoming"
                            domain="[('my_activity_date_deadline', '&gt;', context_today().strftime('%%Y-%%m-%%d'))]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Employee" name="group_employee"
                                context="{'group_by': 'employee_id'}"/>
                        <filter string="Department" name="group_department"
                                context="{'group_by': 'department_id'}"/>
                        <filter string="Request Type" name="group_type"
                                context="{'group_by': 'request_type'}"/>
                        <filter string="Status" name="group_state"
                                context="{'group_by': 'state'}"/>
                        <filter string="Priority" name="group_priority"
                                context="{'group_by': 'priority'}"/>
                        <filter string="Manager" name="group_manager"
                                context="{'group_by': 'manager_id'}"/>
                        <filter string="Month" name="group_date"
                                context="{'group_by': 'date_from:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ============================================================ -->
        <!--                     MAIN ACTION                              -->
        <!-- ============================================================ -->
        <record id="action_hr_internal_request" model="ir.actions.act_window">
            <field name="name">Internal Requests</field>
            <field name="res_model">hr.internal.request</field>
            <field name="view_mode">tree,kanban,form,calendar,activity</field>
            <field name="search_view_id" ref="view_hr_internal_request_search"/>
            <field name="context">{'search_default_my_requests': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first internal request
                </p>
                <p>
                    Submit leave requests, permissions, equipment needs or remote work requests
                    and track them through the approval workflow.
                </p>
            </field>
        </record>

    </data>
</odoo>
