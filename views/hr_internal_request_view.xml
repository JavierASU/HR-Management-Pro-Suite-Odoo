<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_hr_internal_request_tree" model="ir.ui.view">
            <field name="name">hr.internal.request.tree</field>
            <field name="model">hr.internal.request</field>
            <field name="arch" type="xml">
                <tree string="Internal Requests" decoration-success="state == 'hr_approved'" decoration-info="state == 'manager_approved'" decoration-danger="state == 'rejected'">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="request_type"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>
        <record id="view_hr_internal_request_kanban" model="ir.ui.view">
            <field name="name">hr.internal.request.kanban</field>
            <field name="model">hr.internal.request</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state">
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div>
                                    <span t-attf-class="badge kanban-badge-{{ record.state.raw_value }}">{{ record.state.value }}</span>
                                </div>
                                <strong><field name="name"/></strong>
                                <div><field name="employee_id"/></div>
                                <div><field name="request_type"/></div>
                                <div><field name="date_from"/></div>
                                <div><field name="date_to"/></div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <record id="view_hr_internal_request_form" model="ir.ui.view">
            <field name="name">hr.internal.request.form</field>
            <field name="model">hr.internal.request</field>
            <field name="arch" type="xml">
                <form string="Internal Request" class="o_form_hr_internal_request">
                    <header>
                        <button name="action_submit" type="object" string="Submit" class="btn-primary o_form_button_submit" states="draft"/>
                        <button name="action_manager_approve" type="object" string="Manager Approve" class="btn-success o_form_button_approve" states="submitted"/>
                        <button name="action_hr_approve" type="object" string="HR Approve" class="btn-info o_form_button_approve" states="manager_approved"/>
                        <button name="action_reject" type="object" string="Reject" class="btn-danger o_form_button_reject" states="draft,submitted,manager_approved"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,submitted,manager_approved,hr_approved,rejected"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="1"/>
                                <field name="employee_id"/>
                                <field name="request_type"/>
                                <field name="date_from"/>
                                <field name="date_to"/>
                            </group>
                            <group>
                                <field name="manager_id"/>
                                <field name="hr_responsible_id"/>
                                <field name="reason"/>
                            </group>
                        </group>
                        <div class="oe_chatter">
                            <field name="message_follower_ids" widget="mail_followers"/>
                            <field name="activity_ids" widget="mail_activity"/>
                            <field name="message_ids" widget="mail_thread"/>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_hr_internal_request_search" model="ir.ui.view">
            <field name="name">hr.internal.request.search</field>
            <field name="model">hr.internal.request</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="request_type"/>
                    <field name="state"/>
                    <filter string="Pending" domain="[('state', '=', 'submitted')]"/>
                    <filter string="Approved" domain="[('state', 'in', ('manager_approved','hr_approved'))]"/>
                    <filter string="Rejected" domain="[('state', '=', 'rejected')]"/>
                </search>
            </field>
        </record>
        <record id="action_hr_internal_request" model="ir.actions.act_window">
            <field name="name">Internal Requests</field>
            <field name="res_model">hr.internal.request</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="search_view_id" ref="view_hr_internal_request_search"/>
        </record>
    </data>
</odoo>
